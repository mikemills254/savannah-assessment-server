# Copy to .env and fill in real values. Never commit .env.

# ── App ─────────────────────────────────────────────────────────
PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
INVITE_TOKEN_EXPIRE_HOURS=72
# Web OAuth client id (…apps.googleusercontent.com). Leave unset to disable Google sign-in.
GOOGLE_CLIENT_ID=
# Web client base URL, used to build links in emails.
FRONTEND_URL=http://localhost:5173
# Browser origins allowed to call the API, comma-separated. Leave empty
# locally (Vite proxies the API); in production, the client's URL.
CORS_ORIGINS=
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# json (production, for log collectors) or console (readable, for local use).
LOG_FORMAT=console
# Leave on; turn off only for local load experiments.
RATE_LIMIT_ENABLED=true

# ── Mail (SMTP, STARTTLS) ───────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@clinic.com
MAIL_FROM_NAME=Clinic

# ── Postgres (docker compose `postgres` service) ────────────────
POSTGRES_USER=postgres
# Avoid @ : / in it; it goes into connection URLs.
POSTGRES_PASSWORD=
POSTGRES_DB=clinic
POSTGRES_PORT=5446

# Used when running the server, Alembic or the tests directly on your machine
# (the tests use the same server with "_test" appended to the database name).
# 127.0.0.1, not localhost: compose publishes the port on IPv4 only, and
# localhost may try ::1 first, which makes every new connection slow.
# Inside docker compose, `app` and `migrate` override this to use postgres:5432.
DATABASE_URL=postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@127.0.0.1:5446/clinic

# ── Redis (docker compose `redis` service) ──────────────────────
# Avoid @ : / in it; it goes into connection URLs.
REDIS_PASSWORD=
REDIS_PORT=6381

# Used when running the server directly on your machine.
# Inside docker compose, `app` overrides this to use redis:6379.
REDIS_URL=redis://:<REDIS_PASSWORD>@127.0.0.1:6381/0

# ── pgAdmin (dev compose only) ──────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@clinic.com
PGADMIN_DEFAULT_PASSWORD=
PGADMIN_PORT=5056

# ── Redis Commander (dev compose only) ──────────────────────────
REDIS_COMMANDER_USER=admin
REDIS_COMMANDER_PASSWORD=
REDIS_COMMANDER_PORT=8085
